# 範本:由 deploy/install_autostart.sh 填入路徑後安裝到 ~/.config/systemd/user/
[Unit]
Description=YOLO26 booth demo
After=network-online.target

[Service]
WorkingDirectory=__APP_DIR__
ExecStart=__APP_DIR__/.venv/bin/python run.py --profile __PROFILE__
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
